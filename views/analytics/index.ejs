<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Library Analytics & Insights</h1>
    <p class="text-muted mb-0">Visual breakdown of catalog categories, loan statuses, and borrowing trends.</p>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Chart 1: Loan Status Breakdown -->
  <div class="col-12 col-md-6 col-lg-5">
    <div class="glass-card p-4 h-100">
      <h2 class="h5 fw-bold mb-3"><i class="bi bi-pie-chart-fill text-info me-2"></i>Loan Status Distribution</h2>
      <div style="height: 280px; position: relative;">
        <canvas id="statusChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Chart 2: Category Breakdown -->
  <div class="col-12 col-md-6 col-lg-7">
    <div class="glass-card p-4 h-100">
      <h2 class="h5 fw-bold mb-3"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Book Categories</h2>
      <div style="height: 280px; position: relative;">
        <canvas id="categoryChart"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Chart 3: Monthly Loan Activity -->
<div class="row g-4">
  <div class="col-12">
    <div class="glass-card p-4">
      <h2 class="h5 fw-bold mb-3"><i class="bi bi-graph-up text-success me-2"></i>Borrowing Activity Timeline</h2>
      <div style="height: 300px; position: relative;">
        <canvas id="activityChart"></canvas>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const statusData = <%- statusCounts %>;
    const categoryData = <%- categoryStats %>;
    const monthlyData = <%- monthlyStats %>;

    // Status Doughnut Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: ['Active', 'Overdue', 'Returned'],
        datasets: [{
          data: [statusData.active, statusData.overdue, statusData.returned],
          backgroundColor: ['#6366f1', '#ef4444', '#10b981'],
          borderColor: '#1e293b',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: '#94a3b8', font: { family: 'Inter' } }
          }
        }
      }
    });

    // Category Bar Chart
    const categoryCtx = document.getElementById('categoryChart').getContext('2d');
    new Chart(categoryCtx, {
      type: 'bar',
      data: {
        labels: categoryData.map(c => c.category),
        datasets: [{
          label: 'Number of Titles',
          data: categoryData.map(c => c.count),
          backgroundColor: 'rgba(99, 102, 241, 0.7)',
          borderColor: '#6366f1',
          borderWidth: 1,
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255, 255, 255, 0.05)' } },
          y: { ticks: { color: '#94a3b8', precision: 0 }, grid: { color: 'rgba(255, 255, 255, 0.05)' } }
        },
        plugins: {
          legend: { display: false }
        }
      }
    });

    // Monthly Activity Line Chart
    const activityCtx = document.getElementById('activityChart').getContext('2d');
    new Chart(activityCtx, {
      type: 'line',
      data: {
        labels: monthlyData.labels || [],
        datasets: [{
          label: 'Total Checkouts',
          data: monthlyData.data || [],
          borderColor: '#06b6d4',
          backgroundColor: 'rgba(6, 182, 212, 0.15)',
          fill: true,
          tension: 0.4,
          pointBackgroundColor: '#06b6d4'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255, 255, 255, 0.05)' } },
          y: { ticks: { color: '#94a3b8', precision: 0 }, grid: { color: 'rgba(255, 255, 255, 0.05)' } }
        },
        plugins: {
          legend: { labels: { color: '#94a3b8', font: { family: 'Inter' } } }
        }
      }
    });
  });
</script>

<%- include('../partials/footer') %>
